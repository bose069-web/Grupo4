# =============================================================================
#  OPTIMIZACIÓN 2: ajuste de parámetros del modelo y del servidor Ollama
# =============================================================================

# ---- Parámetros de cada petición (los aplica la API) ------------------------

# Máximo de tokens de respuesta (max_tokens). Es el ajuste que más reduce la
# latencia: generar es lo lento. 256 tokens son unas 180-200 palabras.
MODEL_NUM_PREDICT=256

# Temperatura baja: respuestas más estables y repetibles (mejor para la caché).
# Ojo: la temperatura NO cambia la velocidad de generación.
MODEL_TEMPERATURE=0.3

# Sin "razonamiento" previo: Gemma 4 puede generar tokens de pensamiento antes
# de responder, y cuentan como tiempo de generación. false = desactivado.
MODEL_THINK=false

# ---- Servidor Ollama (se aplican al contenedor ollama / ollama-remoto) -------

# Peticiones que Ollama procesa a la vez. Con 1, el resto espera en cola.
# Más paralelo = menos espera, aunque cada respuesta individual vaya algo más lenta.
OLLAMA_NUM_PARALLEL=4

# Contexto por petición. La memoria de contexto se reserva para CADA petición
# paralela: con 4 en paralelo, 2048 x 4 ocupa lo mismo que 8192 x 1.
OLLAMA_CONTEXT_LENGTH=2048

# Flash attention + caché KV en 8 bits: menos RAM por petición, casi sin
# pérdida de calidad. q8_0 requiere flash attention activada.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
