# =============================================================================
#  OPTIMIZACIÓN 1: caché de respuestas frecuentes (en la API)
#
#  - Si una pregunta idéntica (mismo modelo, mensajes y parámetros) ya se
#    respondió hace menos de CACHE_TTL segundos, se devuelve sin llamar a Ollama.
#  - Si llegan varias iguales A LA VEZ, solo la primera va a Ollama y el resto
#    espera su resultado (agrupación de peticiones / "single flight").
#
#  Aplica a local y a remoto (la caché está en la API, no en Ollama).
#  Funciona mejor con temperatura baja (optimización 2): con temperatura alta
#  la misma pregunta daría respuestas distintas y la caché las "congela".
# =============================================================================
CACHE_ENABLED=true

# Segundos que una respuesta sigue siendo válida
CACHE_TTL=600

# Número máximo de respuestas guardadas (se borran las menos usadas)
CACHE_MAX_ITEMS=500
